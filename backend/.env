# SecureNet One - Environment Configuration
# Copy this file to .env and customize

# ── Application ──────────────────────────────────────────────────
APP_NAME=SecureNet One
APP_VERSION=1.0.0
DEBUG=true

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://securenet:securenet@localhost:5432/securenet

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-256-bit-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# ── WireGuard ────────────────────────────────────────────────────
WG_SERVER_ENDPOINT=127.0.0.1:51820
WG_SERVER_PUBLIC_KEY=
WG_SERVER_PRIVATE_KEY=
WG_SUBNET=10.0.0.0/24
WG_DNS=10.0.0.1
WG_INTERFACE=wg0

# ── DNS-over-HTTPS ───────────────────────────────────────────────
DOH_UPSTREAM=https://1.1.1.1/dns-query
DOH_ENABLE_LOGGING=true
DOH_ENABLE_FILTERING=true

# ── Device Heartbeat ─────────────────────────────────────────────
HEARTBEAT_INTERVAL_SECONDS=60
DEVICE_OFFLINE_THRESHOLD_SECONDS=180
